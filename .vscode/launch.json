{
  // 디버거는 파일을 직접 실행해서 sys.path[0] 이 스크립트 폴더(pipeline/)가 된다.
  // repo root 가 경로에 없으면 `import app.core.config` 가 실패한다 — PYTHONPATH 로 넣어준다.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: 현재 파일 (repo root 기준)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        // 출력에 em-dash 가 있어 cp949 콘솔에서 UnicodeEncodeError 가 난다.
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      // --reload 는 뺐다 - 리로더가 워커를 별 프로세스로 띄워서 그쪽엔 디버거가 안 붙는다.
      // 코드 고칠 때마다 이 설정으로 다시 시작(F5)하면 된다.
      "name": "FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--port", "8000"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  ]
}
