{
    // 실행 순서가 고정된 파이프라인이라 태스크로 묶어둔다.
    //   data/*.csv --[load_db]--> pet_reco.db --[chunk]--> chunks --[embed]--> chunk_vectors --[query]--> 검색
    // load_db 를 돌리면 pet_purchases 가 새로 만들어지므로 chunk 와 embed 도 다시 돌려야 한다.
    // 잊더라도 retrieve.py 의 check_freshness() 가 검색 시작 시 경고한다.
    //
    // 각 스크립트가 app.core 를 import 하므로 파일 경로가 아니라 모듈(-m)로 실행한다.
    // 저장소 루트에서 실행돼야 import 가 성립한다.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. DB 적재 (load_csv)",
            "detail": "data/../*.csv 를 pet_reco.db 로 적재한다.",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "pipeline.load_csv"],
            "problemMatcher": [],
            "presentation": { "clear": true }
        },
        {
            "label": "2. 조각 만들기 (chunk)",
            "detail": "리뷰를 임베딩용 문서로 조립하고 토큰 한도에 맞게 잘라 chunks 에 저장한다. 벡터는 만들지 않아 몇 초면 끝난다.",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "pipeline.chunk"],
            "problemMatcher": [],
            "presentation": { "clear": true }
        },
        {
            "label": "3. 색인 생성 (embed)",
            "detail": "chunks 의 조각을 벡터로 변환해 chunk_vectors 에 저장한다. 모델 로딩 포함 20초 남짓 걸린다.",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "pipeline.embed"],
            "problemMatcher": [],
            "presentation": { "clear": true }
        },
        {
            "label": "전체 재구축 (적재 -> 조각 -> 색인)",
            "detail": "CSV 가 바뀌었을 때 쓴다. 1, 2, 3 을 순서대로 실행한다.",
            "dependsOrder": "sequence",
            "dependsOn": [
                "1. DB 적재 (load_csv)",
                "2. 조각 만들기 (chunk)",
                "3. 색인 생성 (embed)"
            ],
            "problemMatcher": [],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "검색 CLI (query)",
            "detail": "질문을 입력받아 유사 리뷰를 찾는다. 입력을 받아야 하므로 전용 터미널에서 연다.",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "app.query"],
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "clear": true }
        },
        {
            "label": "의존성 설치 (requirements)",
            "detail": "README.md 설치 섹션의 패키지를 pet-reco 환경에 설치한다. 한 번만 실행하면 됨.",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m", "pip", "install",
                "langchain-text-splitters==1.1.2", "transformers==5.14.1",
                "langchain-huggingface==1.2.2", "langchain-openai==1.4.3",
                "fastapi==0.141.1", "uvicorn==0.52.0",
                "ragas==0.4.3", "langgraph==1.2.11",
                "sqlite-vec",
            ],
            "problemMatcher": [],
            "presentation": { "clear": true }
        }
    ]
}
