# git에 커밋되는 템플릿 - 어떤 env 값이 필요한지 문서 역할만 한다. 실제 값은 넣지 않는다.
# 실제 값은 .env.local(gitignore)에 넣는다 - config.py의 load_env()가 .env.local을 먼저 읽는다.
JWT_SECRET=
ADMIN_PASSWORD=
USE_API=1
LLM_PROVIDER=anthropic
LLM_API_KEY=
API_MODEL=claude-sonnet-5
VERIFY_PROVIDER=openai
VERIFY_MODEL=gpt-4o-mini
OPENAI_API_KEY=
EMBED_API_KEY=
UNSPLASH_ACCESS_KEY=
FRONTEND_ORIGINS=
SUPABASE_SERVICE_ROLE_KEY=
EMBED_MODEL=
FRONTEND_ORIGINS=