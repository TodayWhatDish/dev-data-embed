# git에 커밋되는 템플릿 - 어떤 env 값이 필요한지 문서 역할만 한다. 실제 값은 넣지 않는다.
# 실제 값은 .env.local(gitignore)에 넣는다 - config.py의 Settings가 .env.local 값을 .env보다 우선한다.
JWT_SECRET=
ADMIN_PASSWORD=

USE_API=1
LLM_PROVIDER=openai
LLM_API_KEY=
API_MODEL=gpt-4o-mini
VERIFY_PROVIDER=anthropic
VERIFY_API_KEY=
VERIFY_MODEL=claude-sonnet-5

EMBED_MODEL=
EMBED_API_KEY=
OPENAI_API_KEY=

SUPABASE_DB_URL=

UNSPLASH_ACCESS_KEY=
FRONTEND_ORIGINS=
